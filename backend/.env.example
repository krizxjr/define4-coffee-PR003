# Supabase Dashboard -> Project Settings -> Database -> Connection string
# Use the direct connection string locally; if your network is IPv4-only, use Supabase's session pooler.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# React dev server origin(s), comma-separated
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Enables file uploads (PDFs, images, Office files, text/code files, audio/video, archives) through Supabase Storage
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=learning-resources

# Local development only. Set false in deployed environments.
AUTO_CREATE_TABLES=true
MAX_CONTENT_LENGTH_MB=50
